# FORJA: copia este archivo a Docker/.env.dev y reemplaza las claves locales.
# Nunca subas .env.dev a Git.
FRONTEND_PORT=3000
BACKEND_PORT=3001
POSTGRES_PORT=5433
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

POSTGRES_USER=forja_dev
POSTGRES_PASSWORD=CAMBIA_POR_PASSWORD_LOCAL_SEGURO
POSTGRES_DB=forja_dev

JWT_SECRET=REEMPLAZAR_POR_UN_VALOR_ALEATORIO_DE_64_CARACTERES_O_MAS
JWT_EXPIRES_IN_SECONDS=7200
EMAIL_VERIFICATION_SECRET=REEMPLAZAR_POR_OTRO_VALOR_ALEATORIO_DE_64_CARACTERES
VERIFICATION_LOG_CODES=true

# SMTP opcional en desarrollo local. No compartir credenciales de correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
